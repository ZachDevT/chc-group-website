rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Categories - allow read for all, write for authenticated users
    match /categories/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Blog posts - allow read for all, write for authenticated users
    match /blogPosts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Partners - allow read for all, write for authenticated users
    match /partners/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Gallery - allow read for all, write for authenticated users
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Authors - allow read for all, write for authenticated users
    match /authors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Team members - allow read for all, write for authenticated users
    match /team/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Job offers - allow read for all, write for authenticated users (HR role)
    match /jobOffers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User roles - only authenticated users can read/write their own or super-admin can manage all
    match /userRoles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || 
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'super-admin');
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

